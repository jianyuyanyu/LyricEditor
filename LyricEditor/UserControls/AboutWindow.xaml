<Window x:Class="LyricEditor.UserControls.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LyricEditor.UserControls"
        Title="关于 LyricEditor"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="15">
        <!-- 头部：图标 + 名称 + 版本 -->
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <Image Width="48"
                   Height="48"
                   Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="Fant"
                   Source="pack://application:,,,/Icons/LrcMaker.ico" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="Bold" Text="LyricEditor" />
                <TextBlock Name="VersionText" Foreground="Gray" />
            </StackPanel>
        </StackPanel>

        <Border Margin="0,0,0,10" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" />

        <!-- 说明文字（联系方式 / 更新日志） -->
        <ScrollViewer Margin="0,0,0,10"
                      MaxHeight="220"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock Name="InfoText" TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- 相关链接 -->
        <TextBlock Margin="0,0,0,10" HorizontalAlignment="Center">
            <Hyperlink NavigateUri="https://zhuanlan.zhihu.com/p/32588196" RequestNavigate="Hyperlink_RequestNavigate">知乎专栏</Hyperlink>
            <Run Text="   |   " />
            <Hyperlink NavigateUri="https://github.com/BYJRK/LyricEditor" RequestNavigate="Hyperlink_RequestNavigate">GitHub</Hyperlink>
            <Run Text="   |   " />
            <Hyperlink NavigateUri="mailto:suomikoto@outlook.com" RequestNavigate="Hyperlink_RequestNavigate">反馈邮件</Hyperlink>
        </TextBlock>

        <Border Margin="0,0,0,10" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" />

        <!-- 更新检查 -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="UpdateStatusText"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       TextWrapping="Wrap" />
            <Button Name="UpdateButton"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Click="UpdateButton_Click"
                    Content="检查更新" />
        </Grid>

        <Button HorizontalAlignment="Right"
                Click="Close_Click"
                Content="关闭"
                IsCancel="True" />
    </StackPanel>
</Window>
