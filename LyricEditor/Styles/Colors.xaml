<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:LyricEditor">

    <SolidColorBrush x:Key="RegularButton.Light" Color="#e5e5e5" />
    <SolidColorBrush x:Key="RegularButton.Normal" Color="#c6c6c6" />
    <SolidColorBrush x:Key="RegularButton.Disabled" Color="#aaa" />

    <SolidColorBrush x:Key="PlayButton.Light" Color="#CFE5D4" />
    <SolidColorBrush x:Key="PlayButton.Normal" Color="#B6F0C2" />

    <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Background" Color="#FFDCECFC" />
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Border" Color="#FF7Eb4EA" />
    <SolidColorBrush x:Key="SliderThumb.Pressed.Background" Color="#FFDAECFC" />
    <SolidColorBrush x:Key="SliderThumb.Pressed.Border" Color="#FF569DE5" />
    <SolidColorBrush x:Key="SliderThumb.Disabled.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SliderThumb.Disabled.Border" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="SliderThumb.Static.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SliderThumb.Static.Border" Color="#FFACACAC" />
    <SolidColorBrush x:Key="SliderThumb.Track.Border" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="SliderThumb.Track.Background" Color="#FFE7EAEA" />

    <!-- 界面通用配色 -->
    <SolidColorBrush x:Key="Surface.Background" Color="White" />
    <SolidColorBrush x:Key="Cover.Background" Color="#D3D3D3" />
    <SolidColorBrush x:Key="PlayPanel.Background" Color="WhiteSmoke" />

    <SolidColorBrush x:Key="Progress.Foreground" Color="LightBlue" />
    <SolidColorBrush x:Key="CurrentLyric.Foreground" Color="#FF9E4848" />
    <SolidColorBrush x:Key="Slider.Label.Foreground" Color="#FF919191" />
    <SolidColorBrush x:Key="Text.Secondary.Foreground" Color="Gray" />

    <SolidColorBrush x:Key="TimeBar.Border" Color="LightGray" />
    <SolidColorBrush x:Key="LrcLine.Separator.Foreground" Color="#DDDDDD" />
    <SolidColorBrush x:Key="Control.Border" Color="#FFABADB3" />
    <SolidColorBrush x:Key="About.Button.Border" Color="#CCCCCC" />
    <SolidColorBrush x:Key="About.Divider.Border" Color="#DDDDDD" />

</ResourceDictionary>